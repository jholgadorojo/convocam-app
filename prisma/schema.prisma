// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonalSelectionProcessStatus {
  INTERESTED
  PREPARING_APPLICATION
  APPLICATION_SUBMITTED
  ADMITTED
  EXCLUDED
  EXAM_PENDING
  EXAM_COMPLETED
  COMPLETED
}

model User {
  id                     String                 @id
  name                   String
  email                  String
  emailVerified          Boolean                @default(false)
  image                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  sessions               Session[]
  accounts               Account[]
  profile                UserProfile?
  userSelectionProcesses UserSelectionProcess[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserProfile {
  id        Int    @id @default(autoincrement())
  userId    String @unique
  firstName String
  lastName  String

  residenceMunicipalityId Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  residenceMunicipality Municipality? @relation(fields: [residenceMunicipalityId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([residenceMunicipalityId])
  @@map("user_profiles")
}

model UserSelectionProcess {
  id                      Int                            @id @default(autoincrement())
  userId                  String                         @map("user_id")
  selectionProcessId      Int                            @map("selection_process_id")
  personalStatus          PersonalSelectionProcessStatus @default(INTERESTED) @map("personal_status")
  followedAt              DateTime                       @default(now()) @map("followed_at")
  personalStatusUpdatedAt DateTime                       @default(now()) @map("personal_status_updated_at")
  updatedAt               DateTime                       @updatedAt @map("updated_at")

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectionProcess SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)

  @@unique([userId, selectionProcessId])
  @@index([selectionProcessId])
  @@map("user_selection_processes")
}

model Institution {
  id     Int    @id @default(autoincrement())
  cidoId String @unique

  name      String
  shortName String
  isActive  Boolean

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  ineCode      String?
  address      String?
  postalCode   String?
  municipality String?
  countyCode   String?
  county       String?
  provinceCode String?
  province     String?

  contractorProfileUrl String?
  socCode              String?
  sepeCode             String?

  selectionProcesses SelectionProcess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([municipality])
  @@index([county])
  @@index([province])
  @@map("institutions")
}

model SelectionProcess {
  id              Int     @id @default(autoincrement())
  cidoId          String  @unique
  cidoIdentifier  String  @unique
  fileNumber      String?
  publicOfferYear Int?

  title           String
  isJobPool       Boolean
  scopeId         Int
  scopeName       String
  institutionName String

  institutionId Int?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  documents              SelectionProcessDocument[]
  subjectAreas           SelectionProcessSubjectArea[]
  userSelectionProcesses UserSelectionProcess[]

  applicationStartDate     DateTime? @db.Date
  applicationEndDate       DateTime? @db.Date
  applicationEndTime       String?
  applicationDeadlineNotes String?

  selectionSystemId    Int?
  selectionSystem      String?
  personnelTypeId      Int?
  personnelType        String?
  qualificationGroupId Int?
  qualificationGroup   String?

  requiredQualification String?
  otherRequirements     String?

  numberOfPositions           Int?
  reservedDisabilityPositions Int?
  reservedUnemployed          Boolean
  reservedYoung               Boolean
  reservedWomen               Boolean

  firstExamDate DateTime? @db.Date
  observations  String?

  institutionUrl String?
  applicationUrl String?
  cidoUrl        String

  statusId Int
  status   String

  lastDocumentPublicationDate DateTime? @db.Date

  sourceSyncedAt   DateTime @default(now())
  sourceHash       String?
  sourceActive     Boolean  @default(true)
  sourceLastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([institutionId])
  @@index([statusId])
  @@index([isJobPool])
  @@index([scopeId])
  @@index([qualificationGroupId])
  @@index([applicationEndDate])
  @@map("selection_processes")
}

model SelectionProcessDocument {
  id     Int    @id @default(autoincrement())
  cidoId String @unique

  selectionProcessId Int
  selectionProcess   SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)

  publicationDate DateTime @db.Date
  summary         String
  publisher       String?

  bulletinId     Int
  bulletin       String
  bulletinNumber Int?
  entryDate      DateTime @db.Date

  phaseId    Int
  phase      String
  phaseNotes String?

  documentUrl String
  htmlUrl     String?

  sourceSyncedAt   DateTime @default(now())
  sourceHash       String?
  sourceActive     Boolean  @default(true)
  sourceLastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([selectionProcessId])
  @@index([publicationDate])
  @@index([phaseId])
  @@map("selection_process_documents")
}

model SubjectArea {
  id           Int    @id @default(autoincrement())
  cidoId       String @unique
  name         String
  cidoModuleId Int

  selectionProcesses SelectionProcessSubjectArea[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subject_areas")
}

model SelectionProcessSubjectArea {
  selectionProcessId Int
  subjectAreaId      Int

  selectionProcess SelectionProcess @relation(fields: [selectionProcessId], references: [id], onDelete: Cascade)
  subjectArea      SubjectArea      @relation(fields: [subjectAreaId], references: [id], onDelete: Cascade)

  @@id([selectionProcessId, subjectAreaId])
  @@index([subjectAreaId])
  @@map("selection_process_subject_areas")
}

model Province {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  municipalities Municipality[]

  @@map("provinces")
}

model County {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  municipalities Municipality[]

  @@map("counties")
}

model Municipality {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  countyId   Int
  provinceId Int

  county   County   @relation(fields: [countyId], references: [id], onDelete: Restrict)
  province Province @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  residenceProfiles UserProfile[]

  @@index([countyId])
  @@index([provinceId])
  @@map("municipalities")
}
